# This `less --quit-if-one-screen -m --mouse +Gg` shows percentage like I want for long
# output, but the output takes up the full screen for files shorter than one screen,
# which makes it not worth overall. Adding `--tilde -s -S -R` options didn't seem to
# help. See https://unix.stackexchange.com/questions/329093 for possible wrapper-based
# solution. See my question https://unix.stackexchange.com/questions/676057 for a
# possible solution without making a wrapper.
[core]
    excludesfile = ~/.gitignore
	pager = less --quit-if-one-screen --mouse --wheel-lines=5

# This does seem to cause all sorts of problems though...
# TODO fix / try deleting and see if current git+github behavior is annoying enough to
# warrant this
# This works for both pull and push. No need to set remote when first setting up.
# https://stackoverflow.com/questions/658885
[branch "master"]
	merge = refs/heads/master
	remote = origin
[push]
	default = simple
[pull]
	ff = only
# Hides the `(use "git add <file>..." ...)` etc hint lines in `git status`
[advice]
	statusHints = false
	# Hides the 4-5 "hint: Updates were rejected because ..." lines after a rejected push
	pushUpdateRejected = false
[alias]
	root = !pwd
	permission-reset = !git diff -p -R --no-ext-diff --no-color | grep -E \"^(diff|(old|new) mode)\" --color=never | git apply
    # adapted from https://gist.github.com/pksunkara/988716
    # may want to pull in some other aliases from there
    bl = blame -C -C -w
	bll = blame -C -C -w -L
    blf = blame -w
	blfl = blame -w -L
    # TODO default to this one tho? it can be much slower. `-C -C` much faster than
    # `-C -C -C`, but may often have same output.
	blm = blame -w -C -C -C
	blml = blame -w -C -C -C -L
[diff]
	wsErrorHighlight = all
	colorMoved = true
[blame]
    date = short
    coloring = highlightRecent
[color "blame"]
	highlightRecent = blue,24 month ago,cyan,12 month ago,white,1 month ago,yellow,7 day ago,red
[init]
	defaultBranch = main
# Keeps Claude Code's /model and /effort defaults out of the committed claude_settings.json
# (see .gitattributes), so changing them mid-session doesn't show up as a diff. Needs jq.
[filter "claude-settings"]
	clean = jq --indent 2 'del(.model, .effortLevel, .modelSettings)'
[credential]
	helper = cache
