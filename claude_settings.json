{
  "permissions": {
    "deny": [
      "Read(**/*.tif)",
      "Read(**/*.p)",
      "Read(**/*.pickle)",
      "Read(**/*.nc)",
      "Read(**/*.parquet)",
      "Read(**/*.a)",
      "Read(**/*.o)",
      "Read(**/*.so)",
      "Read(venv/**)",
      "Read(tmp/**)",
      "Read(.venv/**)",
      "Read(*.egg-info/**)",
      "Read(.git/**)"
    ]
  },
  "env": {
    "UV_PROJECT_ENVIRONMENT": "venv"
  },
  "model": "opus",
  "effortLevel": "medium",
  "modelSettings": {
    "claude-opus-5": {
      "effortLevel": "medium"
    },
    "claude-opus-5-5": {
      "effortLevel": "xhigh"
    },
    "claude-fable-5-1": {
      "effortLevel": "xhigh"
    }
  },
  "tui": "fullscreen",
  "theme": "dark",
  "switchModelsOnFlag": true,
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$HOME/src/al_analysis/scripts/claude_pair_remapping_experiments/session_title_hook.sh\"; [ -x \"$f\" ] && exec \"$f\"; cat >/dev/null; exit 0",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
